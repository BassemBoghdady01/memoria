# Copy to .env.local (never commit real values).
# Public values only: the anon key is safe in the browser because every
# table is protected by Row Level Security. NEVER put the service-role key
# or any payment secret in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Canonical site address for SEO tags and the sitemap, e.g. https://memoria.eg
VITE_SITE_URL=
